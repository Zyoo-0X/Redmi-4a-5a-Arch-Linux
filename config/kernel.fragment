# Native internal-eMMC boot without an initramfs.
# GPT partition discovery and ext4 must be built in so root=PARTUUID can mount userdata.
CONFIG_LOCALVERSION="-riva"
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_MSM8917=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_MSM_GCC_8917=y
CONFIG_COMMON_CLK_SMD_RPM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_I2C_QUP=y
CONFIG_SPI_QUP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MSDOS_PARTITION=y

# Paparan / GPU (Adreno 308 = freedreno a3xx) + butang
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_TOUCHSCREEN_EDT_FT5X06=m

# USB host/OTG + HID
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_OTG=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Wi-Fi (WCN36xx). Firmware vendor TIDAK disertakan - lihat README.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WCN36XX=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_QCOM_WCNSS_PIL=m

# zram: supaya 2 GB RAM terasa lancar
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_SWAP=y
CONFIG_DEBUG_INFO_NONE=y
